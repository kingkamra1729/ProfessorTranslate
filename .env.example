# ---------------------------------------------------------------------------
# Suvidha configuration
#
# Copy this file to .env and fill in what you have:
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. On a hosting platform, set
# these in the dashboard instead of shipping a file - real environment
# variables always win over this file.
#
# Every key is optional. With none of them set the app still runs end to end:
# speech capture and synthesis happen in the browser and cost nothing. Each key
# you add switches one feature from degraded to real.
# ---------------------------------------------------------------------------

PORT=8787

# ----- Translation brain (the one that matters) ----------------------------
# Featherless is OpenAI-compatible. Get a key at https://featherless.ai
# -> Dashboard -> API Keys
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Mixture-of-experts model: ~30B total, ~3B active per token. Live
# interpretation is latency-bound, so active-parameter count matters more than
# raw capability here.
FEATHERLESS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Model for glossary extraction and diagram specs.
#
# Same as the live model, and that is measured rather than assumed. On a
# ~400-token structured generation: this returns clean JSON in ~9s, while
# Qwen3-235B-A22B and Qwen3.5-27B both spent their entire token budget on
# internal reasoning and returned an empty string. Run `npm run bench` to
# re-measure on your own plan.
#
# Using one model everywhere also avoids the provider's model-switching
# throttle, which 429s when a key hops between deployments.
FEATHERLESS_REASONING_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

FEATHERLESS_TIMEOUT_MS=12000

# Maximum simultaneous requests. Featherless reports this per plan at
# /v1/plan - 4 on Feather Chat - and 429s above it. One utterance fans out
# to every language in the room at once, so this ceiling is easy to hit.
FEATHERLESS_CONCURRENCY=4

# Timeout for work off the audio path: diagram specs, glossary extraction.
FEATHERLESS_SLOW_TIMEOUT_MS=90000

# ----- Visualisation -------------------------------------------------------
# Either works; the Cloud API is the more capable route.
# WOLFRAM_APP_ID: https://developer.wolframalpha.com/portal/myapps
# WOLFRAM_CLOUD_API_URL: run scripts/wolfram-deploy.wl in Wolfram Cloud
WOLFRAM_APP_ID=
WOLFRAM_CLOUD_API_URL=
WOLFRAM_TIMEOUT_MS=15000

# ----- Glossary import from a syllabus URL ---------------------------------
# Without it, paste the course text instead.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_TIMEOUT_MS=30000

# ----- Deployment ----------------------------------------------------------
# Origins allowed to call this server. Comma-separated. Leave empty to accept
# any origin, which is right for local development and for a demo whose preview
# URL changes on every push.
#   ALLOWED_ORIGINS=https://suvidha.vercel.app,https://suvidha-git-main-you.vercel.app
ALLOWED_ORIGINS=

# Serve web/dist from this same process: auto | true | false
# "auto" serves it when the build exists, which is what a single-host
# deployment wants and what local development ignores.
SERVE_STATIC=auto

# Where lecture recordings are written. Point this at a mounted disk if
# recordings need to survive a redeploy - many hosts reset the filesystem.
# DATA_DIR=/var/data
