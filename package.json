{
  "name": "suvidha",
  "private": true,
  "version": "0.1.0",
  "description": "AI live lecture translation that preserves technical terms in the language of instruction",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server && npm run test:asr",
    "test:live": "npm run test:live --workspace server",
    "simulate": "npm run simulate --workspace server --",
    "doctor": "npm run doctor --workspace server",
    "test:features": "npm run test:features --workspace server",
    "bench": "npm run bench --workspace server",
    "test:reliability": "npm run test:reliability --workspace server --",
    "test:scout": "npm run test:scout --workspace server",
    "check:deploy": "node scripts/check-case.mjs",
    "test:extract": "npm run test:extract --workspace server",
    "test:asr": "tsx web/src/lib/asr.test.ts",
    "test:deployed": "npm run test:deployed --workspace server --",
    "test:register": "npm run test:register --workspace server --",
    "test:sustained": "npm run test:sustained --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
