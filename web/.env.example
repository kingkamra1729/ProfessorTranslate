# ---------------------------------------------------------------------------
# Frontend build-time configuration
#
# Only needed for a SPLIT deployment - frontend on Vercel, server elsewhere.
# For local development and single-host deployments, leave this unset and every
# request stays same-origin.
#
# Vite inlines VITE_* variables into the bundle at build time, so this value is
# public by design. Never put a secret here.
# ---------------------------------------------------------------------------

# The origin of the realtime server. No trailing slash.
# Must be https:// if the frontend is served over https, or the browser will
# refuse the WebSocket connection.
#   VITE_SERVER_URL=https://suvidha-server.onrender.com
VITE_SERVER_URL=
